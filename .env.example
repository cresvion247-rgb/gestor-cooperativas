# Supabase (client) — never commit real secrets
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Auth redirects (configure in Supabase Dashboard → Authentication → URL Configuration):
#   Site URL: https://your-app.vercel.app  (or http://localhost:5173 for local)
#   Redirect URLs: http://localhost:5173/** , https://your-app.vercel.app/**
# App uses window.location.origin for redirectTo (login OAuth, register, forgot → /reset-password).

# Storage / email (Phase 4) — configure in Supabase Dashboard, not as VITE_ secrets:
#   Buckets: documentos-socio-privados (private), incidencias-fotos (public)
#   Edge secrets: RESEND_API_KEY, EMAIL_FROM  (see STORAGE.md / PHASE4_SUMMARY.md)
